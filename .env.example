# [REQUIRED] To authenticate with Discord, you must create a Discord app.
# See more: https://discord.com/developers/applications
DISCORD_TOKEN=XXXXXX
DISCORD_APP_ID=XXXXXX

# [Optional] To support Spotify links, you must create a Spotify app.
# See more: https://developer.spotify.com/dashboard/applications
SPOTIFY_CLIENT_ID=XXXXXX
SPOTIFY_CLIENT_SECRET=XXXXXX

# [Optional] Directory where guild settings and Spotify tokens are persisted.
# Defaults to data/settings.
# STATE_DIRECTORY=data/settings

# [Optional] When set, loads app.env and cookies.txt from this directory
# instead of the .env file.
# CREDENTIALS_DIRECTORY=/run/secrets

# [Optional] Comma-separated Discord user IDs allowed to run /login.
# When unset, anyone can initiate the Spotify login flow.
# SPOTIFY_ADMIN_IDS=123456789012345678